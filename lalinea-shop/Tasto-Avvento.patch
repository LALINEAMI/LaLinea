+"use client";
+
+import dynamic from "next/dynamic";
+import { useRef, useState } from "react";
+
+const CalendarioConAccesso = dynamic(
+  () => import("../vip/CalendarioAvvento").then((modulo) => modulo.CalendarioConAccesso),
